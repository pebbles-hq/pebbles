[package]
name = "{{name}}"
version = "0.1.0"
edition = "2024"
publish = false

[dependencies]
# default-features = false so THIS app's features (below) choose the render backend.
{{dep_nodefault.pebbles}}

[features]
# Render backend. `vello-hybrid` is Pebbles' current default; `wgpu` is the first-party
# renderer (experimental until it becomes the default). Both are wired here — switch at
# run time without editing this file:
#   pebbles run                    # uses `default` below
#   pebbles run --renderer wgpu    # force the first-party renderer
default = ["{{renderer}}"]
vello-hybrid = ["pebbles/vello-hybrid"]
wgpu = ["pebbles/wgpu"]
